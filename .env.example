# ==============================================================================
# AI Agent Framework Environment Configuration
# ==============================================================================

# Active LLM Provider: openai | anthropic | nvidia_nim | codex | openai_compatible
LLM_PROVIDER=openai

# Global Agent Configuration
AGENT_SYSTEM_PROMPT="You are a helpful, precise, and autonomous AI assistant."
DEFAULT_SESSION_ID=cli:default
REQUEST_TIMEOUT_SECONDS=60.0
# Optional per-phase overrides (fall back to REQUEST_TIMEOUT_SECONDS when omitted)
REQUEST_CONNECT_TIMEOUT_SECONDS=10.0
REQUEST_READ_TIMEOUT_SECONDS=60.0
REQUEST_WRITE_TIMEOUT_SECONDS=60.0
REQUEST_POOL_TIMEOUT_SECONDS=10.0
AGENT_MAX_RETRIES=3

# Ordered JSON list. The active provider must not be repeated here.
FALLBACK_PROVIDERS=[]

# Optional JSON object keyed by model or "provider:model".
# MODEL_METADATA={"openai:gpt-4o-mini":{"context_window":128000,"tool_calling":true}}
MODEL_METADATA={}

# ------------------------------------------------------------------------------
# OpenAI Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Anthropic Configuration
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# NVIDIA NIM Configuration
# ------------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# ------------------------------------------------------------------------------
# Generic OpenAI-Compatible Endpoint Configuration (vLLM / Ollama / Local NIM)
# ------------------------------------------------------------------------------
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_MODEL=default-model

# ------------------------------------------------------------------------------
# Codex OAuth Configuration (Official Mechanism Only)
# ------------------------------------------------------------------------------
CODEX_AUTH_MODE=oauth
CODEX_MODEL=gpt-4o
# Do not store raw tokens in this file. Tokens are managed via official OAuth flows / secure storage.

# ------------------------------------------------------------------------------
# Discord Bot Configuration
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_REQUIRE_MENTION=true
DISCORD_ALLOWED_CHANNEL_IDS=[]
DISCORD_MAX_QUEUE_SIZE=100

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_REQUIRE_MENTION=true
TELEGRAM_ALLOWED_CHAT_IDS=[]

# ------------------------------------------------------------------------------
# Phase 4 Execution Boundary (fail-closed by default)
# ------------------------------------------------------------------------------
# Backend: local | docker
EXECUTION_BACKEND=local
# Root directory that bounds ALL filesystem operations. `..` / absolute paths
# / symlinks that escape this root are rejected.
EXECUTION_SAFE_ROOT=.
# Writes and destructive operations are OFF by default. Turn on explicitly.
EXECUTION_ALLOW_WRITES=false
EXECUTION_ALLOW_DESTRUCTIVE=false
# Subprocess execution is OFF by default; enable only for Phase 5 terminal tools.
EXECUTION_ALLOW_SUBPROCESS=false
# JSON list. Host env vars NOT in this list are NEVER forwarded to child procs.
EXECUTION_ENV_ALLOWLIST=[]
EXECUTION_MAX_FILE_BYTES=1048576
EXECUTION_MAX_OUTPUT_BYTES=65536
EXECUTION_DOCKER_IMAGE=python:3.12-slim
# Command-approval record TTL (seconds).
APPROVAL_DEFAULT_TTL_SECONDS=300.0

# ------------------------------------------------------------------------------
# Phase 5 Built-in Tools (file / terminal / web)
# ------------------------------------------------------------------------------
# Off by default — turn on when you want the LLM to read/write files, run
# subprocesses, or fetch URLs. All routes go through the Phase 4 execution
# backend, so EXECUTION_SAFE_ROOT / EXECUTION_ALLOW_* still gate everything.
ENABLE_BUILTIN_TOOLS=false
BUILTIN_TOOLS_INCLUDE_FILES=true
BUILTIN_TOOLS_INCLUDE_TERMINAL=true
BUILTIN_TOOLS_INCLUDE_WEB=true

# ------------------------------------------------------------------------------
# Phase 6 MCP (Model Context Protocol) integration
# ------------------------------------------------------------------------------
# Off by default. When enabled, MCP_CONFIG_PATH must point at a JSON file
# listing servers to connect on startup. Each entry follows MCPServerConfig:
#   [
#     {
#       "name": "notes",
#       "transport": "stdio",
#       "command": ["node", "servers/notes.js"],
#       "env_allowlist": ["PATH"],
#       "default_risk_level": "medium",
#       "deny_tools": ["delete"]
#     },
#     {
#       "name": "issues",
#       "transport": "http",
#       "url": "https://mcp.example.com/rpc",
#       "headers": {"Authorization": "Bearer ${TOKEN}"},
#       "default_risk_level": "high"
#     }
#   ]
# Discovered tools are namespaced (default: mcp.<server>.<tool>) and routed
# through the same ToolExecutor + policy + HITL approval path as builtin tools.
ENABLE_MCP=false
MCP_CONFIG_PATH=

# ------------------------------------------------------------------------------
# Phase 8 Context Engine
# ------------------------------------------------------------------------------
# When enabled, the Agent trims (or summarizes) conversation history before
# every LLM call so it fits inside the provider's context window. The trimmer
# treats an assistant tool_call + its tool result messages as an atomic group
# and always preserves system messages and the current user turn. A single
# message that exceeds the whole budget raises ContextOverflowError instead of
# being silently truncated.
CONTEXT_MANAGER_ENABLED=true
# trimming: drop oldest atomic groups
# summarizing: LLM-compress middle turns, fall back to trimming on failure
CONTEXT_STRATEGY=trimming
# Fallback budget in tokens when the provider does not advertise context_window.
# CONTEXT_MAX_TOKENS=32000
# Fraction of the provider window reserved for the model's completion.
CONTEXT_HEADROOM_RATIO=0.2
# Cap on tokens requested when the summarizing strategy compresses history.
CONTEXT_SUMMARY_MAX_TOKENS=512
