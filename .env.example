# ==============================================================================
# AI Agent Framework Environment Configuration
# ==============================================================================

# Active LLM Provider: openai | anthropic | nvidia_nim | codex | openai_compatible
LLM_PROVIDER=openai

# Global Agent Configuration
AGENT_SYSTEM_PROMPT="You are a helpful, precise, and autonomous AI assistant."
DEFAULT_SESSION_ID=cli:default
REQUEST_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# OpenAI Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Anthropic Configuration
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# NVIDIA NIM Configuration
# ------------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# ------------------------------------------------------------------------------
# Generic OpenAI-Compatible Endpoint Configuration (vLLM / Ollama / Local NIM)
# ------------------------------------------------------------------------------
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_MODEL=default-model

# ------------------------------------------------------------------------------
# Codex OAuth Configuration (Official Mechanism Only)
# ------------------------------------------------------------------------------
CODEX_AUTH_MODE=oauth
CODEX_MODEL=gpt-4o
# Do not store raw tokens in this file. Tokens are managed via official OAuth flows / secure storage.

# ------------------------------------------------------------------------------
# Discord Bot Configuration
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_REQUIRE_MENTION=true
DISCORD_ALLOWED_CHANNEL_IDS=[]
DISCORD_MAX_QUEUE_SIZE=100

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_REQUIRE_MENTION=true
TELEGRAM_ALLOWED_CHAT_IDS=[]
